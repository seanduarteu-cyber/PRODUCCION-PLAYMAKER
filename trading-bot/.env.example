# Copia este archivo como .env y completa tus claves. El .env NUNCA se sube a GitHub.
# Claves de la cuenta DEMO (demo.binance.com -> API Management)
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Claves de la cuenta REAL (solo cuando la compuerta lo apruebe).
# Crear SIN permiso de retiro y con lista blanca de IP.
BINANCE_REAL_API_KEY=
BINANCE_REAL_API_SECRET=

# Opcional: alertas por Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
