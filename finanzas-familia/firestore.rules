rules_version = '2';

// Reglas de seguridad de Finanzas Familia.
//
// - Cada familia (centro de costos) solo es visible para sus miembros.
// - Nadie puede listar familias ni invitaciones: hay que conocer el código.
// - Los datos financieros llegan cifrados desde el teléfono (campo `enc`);
//   el servidor nunca ve montos, descripciones ni categorías.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function rutaFamilia(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }
    function rutaMiembro(fid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid);
    }
    function rutaInvitacion(codigo) {
      return /databases/$(database)/documents/invites/$(codigo);
    }
    function esMiembro(fid) {
      return autenticado() && exists(rutaMiembro(fid));
    }
    function esAdmin(fid) {
      return esMiembro(fid) && get(rutaMiembro(fid)).data.rol == 'admin';
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function rolValido(r) {
      return r in ['admin', 'miembro'];
    }

    // ---------- Perfil propio (lista de mis familias) ----------
    match /users/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    // ---------- Invitaciones ----------
    // Se leen solo conociendo el código exacto; son de un solo uso y expiran.
    match /invites/{codigo} {
      allow get: if autenticado();
      allow list: if false;
      allow create: if esAdmin(request.resource.data.familyId)
        && request.resource.data.keys().hasOnly(['familyId', 'familyNombre', 'rol', 'creadoPor', 'expira'])
        && request.resource.data.creadoPor == request.auth.uid
        && rolValido(request.resource.data.rol)
        && request.resource.data.expira is timestamp
        && request.resource.data.expira < request.time + duration.value(8, 'd')
        && codigo.matches('^[A-Z2-9]{8}$');
      // Al usarla, el invitado se anota en `usadoPor` (en el mismo lote en que se une).
      allow update: if autenticado()
        && !('usadoPor' in resource.data)
        && resource.data.expira > request.time
        && soloCambia(['usadoPor'])
        && request.resource.data.usadoPor == request.auth.uid;
      allow delete: if esAdmin(resource.data.familyId);
    }

    // ---------- Familias ----------
    match /families/{fid} {
      allow read: if esMiembro(fid);
      allow create: if autenticado()
        && request.resource.data.keys().hasOnly(['nombre', 'creadoPor', 'creadoEn', 'cifrado', 'settingsEnc'])
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.settingsEnc is string
        // quien crea la familia debe quedar como administrador en el mismo lote
        && getAfter(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid)).data.rol == 'admin';
      // Cualquier miembro edita el presupuesto (cifrado); el nombre solo un administrador.
      allow update: if (esMiembro(fid) && soloCambia(['settingsEnc']))
        || (esAdmin(fid) && soloCambia(['settingsEnc', 'nombre'])
            && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80);
      allow delete: if esAdmin(fid);

      // ---------- Miembros ----------
      match /members/{uid} {
        allow read: if esMiembro(fid);
        allow create: if autenticado()
          && uid == request.auth.uid
          && request.resource.data.uid == uid
          && rolValido(request.resource.data.rol)
          && (
            // 1) quien crea la familia (solo en el lote de creación)
            (!exists(rutaFamilia(fid))
              && getAfter(rutaFamilia(fid)).data.creadoPor == request.auth.uid
              && request.resource.data.rol == 'admin')
            ||
            // 2) un invitado con código válido, sin usar y no vencido
            (request.resource.data.codigo is string
              && get(rutaInvitacion(request.resource.data.codigo)).data.familyId == fid
              && !('usadoPor' in get(rutaInvitacion(request.resource.data.codigo)).data)
              && get(rutaInvitacion(request.resource.data.codigo)).data.expira > request.time
              && getAfter(rutaInvitacion(request.resource.data.codigo)).data.usadoPor == request.auth.uid
              && request.resource.data.rol == get(rutaInvitacion(request.resource.data.codigo)).data.rol)
          );
        // Un administrador cambia roles; nadie puede cambiar otros campos.
        allow update: if esAdmin(fid) && soloCambia(['rol']) && rolValido(request.resource.data.rol);
        // Un administrador quita miembros; cualquiera puede salirse.
        allow delete: if esAdmin(fid) || (autenticado() && uid == request.auth.uid);
      }

      // ---------- Datos cifrados ----------
      function coleccionValida(c) {
        return c in ['gastos', 'ingresos', 'boletas', 'deudas', 'adjuntos'];
      }
      function docValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['enc', 'mes', 'creadoPor', 'creadoEn'])
          && d.enc is string
          && d.enc.size() < 1000000
          && d.creadoEn is number
          && (!('mes' in d) || (d.mes is string && d.mes.matches('^[0-9]{4}-[0-9]{2}$')));
      }
      match /{coleccion}/{docId} {
        allow read: if coleccionValida(coleccion) && esMiembro(fid);
        allow create: if coleccionValida(coleccion) && esMiembro(fid) && docValido()
          && request.resource.data.creadoPor == request.auth.uid;
        allow update: if coleccionValida(coleccion) && esMiembro(fid) && docValido()
          && request.resource.data.creadoPor == resource.data.creadoPor;
        allow delete: if coleccionValida(coleccion) && esMiembro(fid);
      }
    }
  }
}
