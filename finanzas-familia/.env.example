# Copia este archivo como .env.local (o carga estas variables en Netlify:
# Site configuration > Environment variables).
# Si lo dejas vacío, la app funciona en "modo demostración" (datos solo en el teléfono).

# --- Supabase (recomendado) ---
# Supabase > Project Settings > API (o "Connect"): Project URL y la llave pública
# "anon" / "publishable". Esa llave es pública: la seguridad la dan las reglas del
# esquema (supabase/esquema.sql) y el cifrado de la app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Pon 1 si activaste el inicio de sesión con Google en Supabase (Authentication > Providers).
VITE_SUPABASE_GOOGLE=

# --- Firebase (alternativa; déjalo vacío si usas Supabase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
