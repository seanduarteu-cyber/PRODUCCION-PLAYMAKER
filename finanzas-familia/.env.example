# Copia este archivo como .env.local y pega los datos de tu proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > App web > Configuración).
# Si lo dejas vacío, la app funciona en "modo demostración" (datos solo en el teléfono).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
